    <!-- Mode picker -->
    <string name="mode_dialog_title">Choose a blocking method</string>
    <string name="mode_option_block">Block only the apps I select</string>
    <string name="mode_option_allow">Allow only the apps I select</string>
    <string name="mode_label_allow">Allowed apps only</string>
