<?xml version="1.0" encoding="utf-8"?>
<!--
    English is the default locale. Every key here must also exist in
    res/values-iw/strings.xml (Android's resource qualifier for Hebrew), except
    for the language autonyms marked translatable="false", which are shown in
    their own language on every locale.

    app/src/test/java/com/example/lockdowndpc/ui/LocaleParityTest.kt and
    tools/check_locale_parity.py both enforce that rule, including plural
    categories and format placeholders.
-->
<resources>
    <string name="app_name">Device Guard</string>
    <string name="admin_label">Device management and protection</string>
    <string name="admin_description">Manage apps, block installations, and restrict internet access.</string>
    <string name="not_device_owner">Cannot activate: system administration is not configured.</string>
    <plurals name="policy_applied">
        <item quantity="one">Protection is active and verified. %1$d app is blocked.</item>
        <item quantity="other">Protection is active and verified. %1$d apps are blocked.</item>
    </plurals>
    <string name="policy_failed">Protection was not fully applied, so it is not marked as active.\nFirst detail: %1$s</string>
    <string name="configured">Configured</string>
    <string name="configuration_required">Setup required</string>
    <string name="active">Active</string>
    <string name="not_configured">Not configured</string>

