    <string name="pin_setup_title">Set an administrator PIN</string>
    <string name="pin_setup_title_replace">Change the administrator PIN</string>
    <string name="pin_setup_subtitle">Choose a PIN of 6 to 12 digits. The PIN is required to change the app list or to pause protection.</string>
    <string name="pin_setup_field_new">New administrator PIN</string>
    <string name="pin_setup_field_confirm">Confirm the PIN</string>
    <string name="pin_setup_save">Save the PIN and continue</string>
    <string name="pin_setup_save_replace">Save the new PIN</string>
    <string name="pin_error_format">The PIN must contain 6 to 12 digits.</string>
    <string name="pin_error_mismatch">The two PINs do not match.</string>
    <string name="pin_error_save">The PIN could not be saved on this device.</string>

    <!-- Locked -->
    <string name="locked_title">Protection management</string>
    <string name="locked_subtitle">Device settings are locked. Enter the administrator PIN to make changes.</string>
    <string name="locked_field_pin">Administrator PIN</string>
    <string name="locked_unlock">Open management</string>
    <string name="pin_error_invalid">Incorrect administrator PIN.</string>
    <string name="pin_error_verify">The PIN could not be verified. Contact the device administrator.</string>
    <plurals name="lockout_seconds">
        <item quantity="one">Too many attempts. You can try again in %1$d second.</item>
        <item quantity="other">Too many attempts. You can try again in %1$d seconds.</item>
