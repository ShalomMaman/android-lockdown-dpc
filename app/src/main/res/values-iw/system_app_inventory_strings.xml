<?xml version="1.0" encoding="utf-8"?>
<!--
    Hebrew translation of the system-application inventory (Issue #18).

    The folder qualifier is "iw" for the same reason as strings.xml: Android
    resolves resource folders against java.util.Locale#getLanguage(), which
    still reports the legacy Hebrew code.

    Latin runs inside a Hebrew sentence (Android, WebView, OEM, Device Guard's
    English-sourced technical terms) are wrapped in U+2066 LEFT-TO-RIGHT
    ISOLATE / U+2069 POP DIRECTIONAL ISOLATE so the bidi algorithm cannot drag
    the surrounding punctuation to the wrong side. Runtime values — package
    names, digests, versions — are isolated in code instead; see ui/UiLogic.kt.

    Keys, plural categories and format placeholders are kept in parity with
    res/values/system_app_inventory_strings.xml by
    SystemAppInventoryStringsParityTest.kt.
-->
<resources>

    <!-- Screen frame -->
    <string name="sysinv_title">מלאי האפליקציות</string>
    <string name="sysinv_subtitle">כל האפליקציות שמותקנות במכשיר, כולל רכיבי מערכת של ⁦Android⁩. מה שאפשר לחסום נקבע לפי רמת הבטיחות של כל שורה.</string>
    <string name="sysinv_search">חיפוש לפי שם או מזהה חבילה</string>
    <string name="sysinv_search_clear">ניקוי החיפוש</string>
    <string name="sysinv_loading">קוראים את מלאי האפליקציות…</string>
    <string name="sysinv_no_results_title">אין אפליקציות תואמות</string>
    <string name="sysinv_no_results_body">אף אפליקציה לא מתאימה לחיפוש ולסינון האלה.</string>

    <!-- Filters -->
    <string name="sysinv_filter_label">סינון</string>
    <string name="sysinv_filter_all">הכול</string>
    <string name="sysinv_filter_user">הותקנו על ידי משתמש</string>
    <string name="sysinv_filter_system">מערכת</string>
    <string name="sysinv_filter_store">חנויות והתקנות</string>
    <string name="sysinv_filter_browser">דפדפנים</string>
    <string name="sysinv_filter_social">רשתות חברתיות</string>
    <string name="sysinv_filter_management">ניהול</string>
    <string name="sysinv_filter_protected">מוגנות</string>

    <!-- Row state -->
    <string name="sysinv_state_allowed">מותרת</string>
    <string name="sysinv_state_blocked">חסומה</string>
    <string name="sysinv_state_protected">מוגנת</string>

    <!-- Origin -->
    <string name="sysinv_origin_user">הותקנה על ידי משתמש</string>
    <string name="sysinv_origin_system">מערכת</string>
    <string name="sysinv_origin_updated_system">מערכת מעודכנת</string>

