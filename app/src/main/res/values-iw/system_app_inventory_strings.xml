    <!-- Reasons -->
    <string name="sysinv_reason_device_guard">מגן המכשיר עצמו; לעולם אי אפשר לחסום אותו.</string>
    <string name="sysinv_reason_essential_system">רכיב חיוני של ⁦Android⁩. חסימה שלו עלולה להשאיר את המכשיר במצב שאי אפשר לתקן מהמסך הזה.</string>
    <string name="sysinv_reason_management">אמצעי ניהול מאומת. חסימה שלו תבטל את הגישה מרחוק למכשיר.</string>
    <string name="sysinv_reason_active_input_method">המקלדת הפעילה. חסימה שלה תשאיר את המכשיר בלי אפשרות להקליד.</string>
    <string name="sysinv_reason_active_webview">ספק ⁦WebView⁩ הפעיל. חסימה שלו תשבור כל אפליקציה שמציגה תוכן אינטרנט.</string>
    <string name="sysinv_reason_always_blocked">חסומה על ידי קטלוג החנויות והדפדפנים המובנה.</string>
    <string name="sysinv_reason_kiosk_escape">נתיב יציאה ממצב קיוסק. מנוהל על ידי פרופיל הקיוסק ולא ידנית.</string>
    <string name="sysinv_reason_known_catalog">מסווגת על ידי קטלוג הדפדפנים והרשתות החברתיות המובנה.</string>
    <string name="sysinv_reason_known_manageable">אפליקציית מערכת שנבדקה. אין לה תפקיד ב⁦Android⁩ שאי אפשר לשחזר מהמסך הזה.</string>
    <string name="sysinv_reason_unclassified_oem">רכיב ⁦OEM⁩ לא מסווג. צריך לבדוק אותו לפני שאפשר לחסום.</string>
    <string name="sysinv_reason_unclassified_oem_drift">החתימה או הגרסה השתנו מאז אישור הסיכון. האישור כבר לא תקף.</string>
    <string name="sysinv_reason_unclassified_oem_accepted">הסיכון אושר על ידי מנהל במכשיר הזה.</string>
    <string name="sysinv_reason_ordinary">אפליקציה רגילה תחת המדיניות שנבחרה.</string>

    <!-- Advanced risk acceptance -->
    <string name="sysinv_risk_action">בדיקת הרכיב הזה…</string>
    <string name="sysinv_risk_title">לאשר את הסיכון בניהול הרכיב הזה?</string>
    <string name="sysinv_risk_body">רכיב ⁦OEM⁩ יכול להיות הכרחי לגרסת הקושחה הזאת גם כששמו נראה תמים. חסימה של הרכיב הלא נכון עלולה לשבור את המקלדת, את מסך הבית, את הטלפוניה או את העדכונים, ויכול להיות שאי אפשר יהיה לתקן זאת מהמסך הזה.</string>
    <string name="sysinv_risk_record_intro">האישור הזה נרשם יחד עם:</string>
    <string name="sysinv_risk_field_package">מזהה חבילה: %1$s</string>
    <string name="sysinv_risk_field_signer">טביעת אצבע של החתימה: %1$s</string>
    <string name="sysinv_risk_field_version">גרסה: %1$s</string>
    <string name="sysinv_risk_field_prior_state">המצב לפני השינוי: %1$s</string>
    <string name="sysinv_risk_field_firmware">גרסת הקושחה: %1$s</string>
    <string name="sysinv_risk_unknown_value">לא ניתן לקריאה</string>
    <string name="sysinv_risk_confirm">אישור הסיכון</string>
    <string name="sysinv_risk_cancel">ביטול</string>
    <string name="sysinv_risk_drift_warning">הרכיב הזה אושר בעבר, אבל החתימה או הגרסה שלו השתנו מאז. אישור מחדש ירשום את הזהות החדשה.</string>

    <!-- Save confirmation -->
    <string name="sysinv_save">שמירת הבחירה</string>
    <string name="sysinv_save_confirm_title">להחיל את בחירת אפליקציות המערכת?</string>
    <string name="sysinv_save_confirm_body">מגן המכשיר יבקש להחיל את המדיניות ואז יאמת אותה. ההגנה תדווח כפעילה רק אחרי ש⁦Android⁩ יאשר כל שינוי.</string>
    <string name="sysinv_save_confirm_action">שמירה והחלה</string>
    <string name="sysinv_save_confirm_cancel">חזרה</string>
    <string name="sysinv_row_description">%1$s, מזהה חבילה %2$s, %3$s, %4$s</string>
    <string name="sysinv_audit_system_saved">בחירת אפליקציות המערכת נשמרה</string>

    <plurals name="sysinv_system_selected_count">
        <item quantity="one">נבחר רכיב מערכת אחד</item>
        <item quantity="two">נבחרו שני רכיבי מערכת</item>
        <!--
            The `other` branch is the one every count from 0 and from 3 upward
            selects, so it is the branch that has to be able to show the count
            argument itself; the `one` and `two` branches name it in words.
        -->
        <item quantity="other">נבחרו %1$d רכיבי מערכת</item>
    </plurals>

</resources>
