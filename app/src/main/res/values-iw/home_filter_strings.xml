    <string name="home_filter_corrupt_settings">לא ניתן לקרוא את ההגדרות השמורות של הסינון הביתי. יש לפנות למנהל המכשיר לשחזור ההגדרות.</string>
    <string name="home_filter_requires_android_10">הסינון הביתי זמין מגרסת Android 10 ‏(API 29) ומעלה.</string>
