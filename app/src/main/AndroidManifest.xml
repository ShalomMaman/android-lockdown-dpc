<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A fully managed DPC must inventory installed packages to enforce its allowlist. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AllowedAppsActivity"
            android:exported="false" />

        <!--
            Kiosk HOME surface. Disabled in the manifest so an upgrade never turns
            a managed device into a kiosk; KioskController enables the component
            and installs the HOME preference only while kiosk is active, and
            disables it again on exit. It must be exported because the system
            starts HOME, but it grants nothing: it renders stored kiosk state and
            the only way out is an authenticated administrator session.
        -->
        <activity
            android:name=".kiosk.KioskHostActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=".kiosk"
            android:theme="@style/AppTheme">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BlockedBrowserActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".admin.LockdownAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
            Locale configuration only. On API 33+ AppCompat forwards the display
            language to the platform LocaleManager; below that it needs this
            marker service to persist the choice across process restarts. The
            component is never started, which is why it stays disabled.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            A DeviceAdminService is the Android-supported way for a device owner
            targeting API 26+ to keep a runtime package receiver available. The
            BIND_DEVICE_ADMIN permission prevents other apps from binding it.
        -->
        <service
            android:name=".admin.LockdownDeviceAdminService"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".updates.UpdateCheckJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".updates.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.PolicyRefreshReceiver"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.PolicyUpdateAuditReceiver"
            android:enabled="@bool/policy_update_receiver_enabled"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.admin.action.DEVICE_POLICY_SET_RESULT" />
                <action android:name="android.app.admin.action.DEVICE_POLICY_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
