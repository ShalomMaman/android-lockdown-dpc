<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A fully managed DPC must inventory installed packages to enforce its allowlist. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required when JobScheduler enforces network constraints for update checks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Night and work hours boundaries fire on time when exact alarms are
        permitted; without it they fall back to inexact alarms. Granted by
        default on Android 12 and 13, an administrator choice on Android 14+.
        See policy/ScheduleAlarm.java.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AllowedAppsActivity"
            android:exported="false" />

        <!--
            System policy controls. Not exported: it is opened from the console
            only, and it refuses to draw at all without a live administrator
            session, so nothing outside this package can reach the switches that
            withdraw the device recovery path.
        -->
        <activity
            android:name=".ui.SystemPolicyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.HomeFilterActivity"
            android:exported="false" />

        <!--
            Management identity console. Not exported for the same reason: it
            writes the signing-certificate pins that decide which package is
            allowed to keep management privilege, and a pin written by anything
            other than an authenticated administrator would be a privilege grant.
        -->
        <activity
            android:name=".ui.ManagementIdentityActivity"
            android:exported="false" />

        <!--
            Timed maintenance mode. Not exported: this screen deliberately makes a
            managed device weaker for a bounded period, including the break-glass
            debugging option, so it is reachable only from an authenticated
            administrator session inside this package.
        -->
        <activity
            android:name=".ui.MaintenanceActivity"
            android:exported="false" />

        <!--
            Local device health report. Not exported: the report names policy
            state, kiosk state and management identity, and the export is an
            explicit administrator action rather than something another
            application may ask for.
        -->
        <activity
            android:name=".ui.DeviceHealthActivity"
            android:exported="false" />

        <!--
            Kiosk HOME surface. Disabled in the manifest so an upgrade never turns
            a managed device into a kiosk; KioskController enables the component
            and installs the HOME preference only while kiosk is active, and
            disables it again on exit. It must be exported because the system
            starts HOME, but it grants nothing: it renders stored kiosk state and
            the only way out is an authenticated administrator session.
        -->
        <activity
            android:name=".kiosk.KioskHostActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=".kiosk"
            android:theme="@style/AppTheme">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BlockedBrowserActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".admin.LockdownAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
            Locale configuration only. On API 33+ AppCompat forwards the display
            language to the platform LocaleManager; below that it needs this
            marker service to persist the choice across process restarts. The
            component is never started, which is why it stays disabled.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            A DeviceAdminService is the Android-supported way for a device owner
            targeting API 26+ to keep a runtime package receiver available. The
            BIND_DEVICE_ADMIN permission prevents other apps from binding it.
        -->
        <service
            android:name=".admin.LockdownDeviceAdminService"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".updates.UpdateCheckJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Closes a maintenance window that has run out, whether or not the
            console is open. Exported with BIND_JOB_SERVICE because that is how
            JobScheduler binds; the permission means only the platform can.
        -->
        <service
            android:name=".maintenance.MaintenanceGuardJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Night and work hours catch-up sweep, armed only while a schedule is
            enforcing. Exported with BIND_JOB_SERVICE for the same reason as
            the maintenance guard: only the platform can bind it.
        -->
        <service
            android:name=".policy.ScheduleSweepJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".updates.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.PolicyRefreshReceiver"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!--
                    Night and work hours: a clock, timezone or exact alarm
                    access change re-runs the policy pass. The boundary alarm
                    itself targets this receiver explicitly.
                -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.PolicyUpdateAuditReceiver"
            android:enabled="@bool/policy_update_receiver_enabled"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.admin.action.DEVICE_POLICY_SET_RESULT" />
                <action android:name="android.app.admin.action.DEVICE_POLICY_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Shell-only administrator PIN bridge for scripted setup and
            maintenance over ADB. Exported without a manifest permission
            because Android has no shell-only permission; ShellPinProvider.call
            checks Binder.getCallingUid() == Process.SHELL_UID (2000) as its
            first line and refuses every other caller, including root (UID 0).
            Anyone with an authorized ADB connection (or a tool running as the
            shell UID) can reach this provider whenever USB debugging is
            allowed: DISALLOW_DEBUGGING_FEATURES is on by default only on
            production builds, pilot builds keep ADB enabled as the break-glass
            path, and an explicit production maintenance window can clear it.
            Within that boundary, set-initial only works when no PIN is
            configured, and replace and verify enforce the same progressive
            lockout policy as the on-screen PIN prompt.
        -->
        <provider
            android:name=".security.ShellPinProvider"
            android:authorities="${applicationId}.shellpin"
            android:directBootAware="false"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>
